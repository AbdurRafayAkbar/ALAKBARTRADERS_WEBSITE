# Copy to backend/.env and fill in real values. Never commit .env.

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://alakbar:change-me@localhost:5432/alakbartraders

# Prod only (comma-separated)
# DJANGO_ALLOWED_HOSTS=alakbartraders.pk,www.alakbartraders.pk
# DJANGO_CSRF_TRUSTED_ORIGINS=https://alakbartraders.pk,https://www.alakbartraders.pk

# DJANGO_SETTINGS_MODULE is not read from this file. manage.py defaults to
# config.settings.dev and wsgi.py (Gunicorn) to config.settings.prod.
